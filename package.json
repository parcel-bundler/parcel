{
  "name": "@parcel/monorepo",
  "description": "Blazing fast, zero configuration web application bundler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parcel-bundler/parcel.git"
  },
  "private": true,
  "workspaces": [
    "packages-v3/*"
  ],
  "scripts": {
    "build": "gulp",
    "check-ts": "tsc -p packages-v3",
    "clean": "gulp clean",
    "format": "oxfmt packages-v3 && cargo +nightly fmt --all",
    "lint": "oxfmt --check packages-v3 && cargo fmt --all -- --check",
    "test:unit": "cargo test --workspace",
    "test": "yarn test:unit",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@babel/core": "^7.22.11",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/plugin-syntax-typescript": "^7.25.9",
    "@babel/preset-env": "^7.22.14",
    "@napi-rs/cli": "^2.18.3",
    "@swc/core": "^1.11.24",
    "@swc/helpers": "^0.5.0",
    "@types/node": "^22.15.17",
    "assert": "^2.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "buffer": "mischnic/buffer#b8a4fa94",
    "date-fns": "^4.1.0",
    "domain-browser": "^5.7.0",
    "events": "^3.3.0",
    "gulp": "^4.0.2",
    "husky": "^6.0.0",
    "lint-staged": "^10.5.4",
    "lodash": "^4.17.21",
    "nib": "^1.2.0",
    "os-browserify": "^0.3.0",
    "oxfmt": "^0.73.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.3",
    "postcss-custom-properties": "^12.1.11",
    "postcss-import": "^16.1.0",
    "posthtml-include": "^2.0.1",
    "posthtml-obfuscate": "^0.1.5",
    "preact": "^10.26.6",
    "process": "^0.11.10",
    "punycode": "^2.3.1",
    "querystring-es3": "^0.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^5.0.10",
    "semver": "^7.7.1",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tailwindcss": "^4",
    "tty-browserify": "^0.0.1",
    "typescript": "^5",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "lint-staged": {
    "packages-v3/**/*.{js,jsx,ts,tsx,json,md}": "oxfmt --no-error-on-unmatched-pattern",
    "*.rs": "rustfmt"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/parcel"
  },
  "packageManager": "yarn@4.18.1",
  "browser": {
    "react": "preact/compat",
    "react-dom": "preact/compat",
    "scheduler": false
  },
  "_": "See issue #9405 for the Vue problem",
  "__": "The watcher complains about non-existing dirs in the integration tests on >=2.3.0",
  "resolutions": {
    "@parcel/watcher": "~2.2.0",
    "@vue/compiler-sfc": "~3.2.47",
    "vue": "~3.2.47"
  }
}
