{
  "name": "@parcel/monorepo",
  "description": "Blazing fast, zero configuration web application bundler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parcel-bundler/parcel.git"
  },
  "private": true,
  "workspaces": [
    "packages-v3/*"
  ],
  "scripts": {
    "build": "gulp",
    "check-ts": "tsc -p packages-v3",
    "clean": "lerna clean --yes && gulp clean && yarn",
    "format": "cargo +nightly fmt --all",
    "lint": "cargo fmt --all -- --check",
    "prepublishOnly": "yarn build && yarn check-ts",
    "test:unit": "cargo test --workspace",
    "test": "yarn test:unit",
    "dev:release": "SKIP_PLUGIN_COMPATIBILITY_CHECK=true lerna publish -y --canary --preid dev --dist-tag=dev --exact --force-publish='*' --no-git-tag-version --no-push",
    "canary:release": "SKIP_PLUGIN_COMPATIBILITY_CHECK=true lerna publish -y --canary --preid canary --dist-tag=canary --exact --force-publish='*' --no-git-tag-version --no-push",
    "tag:prerelease": "lerna version --exact --force-publish='*' --no-git-tag-version --no-push",
    "tag:release": "lerna version --exact --force-publish='*' --no-git-tag-version --no-push",
    "release": "lerna publish -y from-package --pre-dist-tag=next --no-git-tag-version --no-push",
    "prepare": "husky install",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@babel/core": "^7.22.11",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/plugin-syntax-typescript": "^7.25.9",
    "@babel/preset-env": "^7.22.14",
    "@khanacademy/flow-to-ts": "^0.5.2",
    "@napi-rs/cli": "^2.18.3",
    "@swc/core": "^1.11.24",
    "@swc/helpers": "^0.5.0",
    "@types/node": "^22.15.17",
    "assert": "^2.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "buffer": "mischnic/buffer#b8a4fa94",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "domain-browser": "^5.7.0",
    "eslint": "^8.57.1",
    "events": "^3.3.0",
    "fast-glob": "^3.3.3",
    "flow-bin": "0.184.0",
    "gulp": "^4.0.2",
    "husky": "^6.0.0",
    "lerna": "^6.6.2",
    "lint-staged": "^10.5.4",
    "nib": "^1.2.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.3",
    "postcss-custom-properties": "^12.1.11",
    "postcss-import": "^16.1.0",
    "posthtml-include": "^2.0.1",
    "posthtml-obfuscate": "^0.1.5",
    "preact": "^10.26.6",
    "prettier": "2.4.1",
    "process": "^0.11.10",
    "punycode": "^2.3.1",
    "querystring-es3": "^0.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^5.0.10",
    "semver": "^7.7.1",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "tailwindcss": "^4",
    "tty-browserify": "^0.0.1",
    "typescript": "^5",
    "url": "^0.11.4",
    "util": "^0.12.5"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "lint-staged": {
    "*.{js,json,md,ts}": "prettier --write",
    "*.rs": "rustfmt"
  },
  "collective": {
    "type": "opencollective",
    "url": "https://opencollective.com/parcel"
  },
  "packageManager": "yarn@4.9.1",
  "browser": {
    "react": "preact/compat",
    "react-dom": "preact/compat",
    "scheduler": false
  },
  "dependencies": {
    "patch-package": "^8.0.0"
  },
  "_": "See issue #9405 for the Vue problem",
  "__": "The watcher complains about non-existing dirs in the integration tests on >=2.3.0",
  "resolutions": {
    "@parcel/watcher": "~2.2.0",
    "@vue/compiler-sfc": "~3.2.47",
    "vue": "~3.2.47"
  }
}
