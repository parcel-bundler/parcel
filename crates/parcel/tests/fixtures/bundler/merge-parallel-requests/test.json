{
  "description": "Parallel script requests share an activation; protected roots and zero extra bytes bound consolidation",
  "input": ["one.html", "two.html"],
  "options": {
    "config": ".parcelrc"
  },
  "bundles": [
    {
      "assets": ["one.html"]
    },
    {
      "assets": ["two.html"]
    },
    {
      "assets": ["a.js", "shared.js"],
      "references": []
    },
    {
      "assets": ["b.js", "shared.js"],
      "references": []
    }
  ],
  "skipNodeModules": true
}
