{
  "description": "Inline roots cannot inherit availability from preceding external scripts",
  "input": "index.html",
  "bundles": [
    {
      "assets": ["index.html"],
      "type": "html"
    },
    {
      "assets": ["a.js"],
      "references": [["value.js"]]
    },
    {
      "assets": ["index.html"],
      "type": "js",
      "references": [["value.js"]]
    },
    {
      "assets": ["value.js"]
    }
  ]
}
