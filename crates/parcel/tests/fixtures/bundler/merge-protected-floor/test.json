{
  "description": "Independent HTML page outputs retain their mandatory script requests even below the achievable request floor",
  "input": ["one.html", "two.html"],
  "options": {
    "mode": "production",
    "config": ".parcelrc"
  },
  "bundles": [
    {
      "assets": ["one.html"],
      "references": []
    },
    {
      "assets": ["two.html"],
      "references": []
    },
    {
      "assets": ["a.js"],
      "references": [["shared.js"]]
    },
    {
      "assets": ["b.js"],
      "references": [["shared.js"]]
    },
    {
      "assets": ["shared.js"],
      "references": []
    }
  ],
  "skipNodeModules": true
}
