{
  "description": "Nested workers reset availability while lazy descendants reuse assets within their worker",
  "input": "index.js",
  "bundles": [
    {
      "assets": ["index.js", "value.js"],
      "environment": "browser"
    },
    {
      "assets": ["worker-a.js"],
      "environment": "web-worker",
      "references": [["value.js"]]
    },
    {
      "assets": ["worker-b.js"],
      "environment": "web-worker",
      "references": [["value.js"]]
    },
    {
      "assets": ["lazy.js"],
      "environment": "web-worker",
      "references": []
    },
    {
      "assets": ["value.js"],
      "environment": "web-worker",
      "references": []
    }
  ]
}
