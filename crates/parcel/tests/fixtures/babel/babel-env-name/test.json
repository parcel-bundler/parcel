  },
  {
    "description": "should not apply env config for other environments",
    "input": "index.js",
    "options": {"env": {"BABEL_ENV": "development", "NODE_ENV": "production"}},
    "bundles": [{"name": "index.js", "assets": ["index.js"], "contains": ["class Foo"]}]
  }
