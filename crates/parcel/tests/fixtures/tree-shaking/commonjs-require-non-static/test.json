[
  {
    "description": "tree shaking: computed access of a required module keeps every export",
    "input": "computed.js",
    "options": {"mode": "production"},
    "sideEffects": ["used", "unused-computed-sentinel"],
    "bundles": [
      {
        "type": "js",
        "assets": ["computed.js", "dep-computed.js"],
        "contains": ["unused-computed-sentinel"]
      }
    ]
  },
  {
    "description": "tree shaking: passing a required module elsewhere keeps every export",
