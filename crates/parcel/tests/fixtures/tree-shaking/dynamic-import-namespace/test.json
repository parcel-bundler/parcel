        "contains": ["used-dynamic"],
        "notContains": ["unused-dynamic-sentinel"]
      }
    ]
  },
  {
    "description": "tree shaking: dynamic import namespace accessed statically works in development",
    "input": "dynamic.js",
    "output": "used-dynamic"
  }
]
