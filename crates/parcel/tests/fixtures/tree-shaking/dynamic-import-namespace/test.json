  {
    "description": "tree shaking: dynamic import removes unused async export when the namespace is only accessed statically",
    "input": "dynamic.js",
    "options": {"mode": "production"},
    "output": "used-dynamic",
    "bundles": [
      {
        "type": "js",
        "assets": ["dynamic.js"],
