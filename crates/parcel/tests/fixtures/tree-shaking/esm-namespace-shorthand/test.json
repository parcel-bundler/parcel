{
  "description": "tree shaking: namespace import in a shorthand property keeps every export",
  "input": "namespace.js",
  "options": {"mode": "production"},
  "sideEffects": ["used-namespace", "unused-namespace-sentinel"],
  "bundles": [
    {
      "type": "js",
      "assets": ["dep-namespace.js", "esmodule-helpers.js", "namespace.js"],
      "contains": ["used-namespace", "unused-namespace-sentinel"]
    }
  ]
}
