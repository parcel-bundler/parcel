[
  {
    "description": "private exports: modules whose exports are only read statically have their exports renamed",
    "input": "index.js",
    "options": {
      "mode": "production"
    },
    "output": [
      "value",
      "default",
      "value",
      "default",
      "method",
      "star",
      "collision",
      "barrel",
      "escapedExportName",
      "value-async",
      "mappedExportName,mapped,otherMappedExportName,other,ownExport,own,with,comma,comma",
      "mapped",
      "indirect"
    ],
    "bundles": [
      {
        "type": "js",
        "assets": [
          "async.js",
          "barrel.js",
          "escaped.js",
          "index.js",
          "indirect-barrel.js",
          "indirect-star.js",
          "lib.js",
          "mapped.js",
          "public-barrel.js",
          "reexport.js",
          "star-collision.js",
          "star.js"
        ],
        "contains": [
          "escapedExportName:()=>",
          "ownExport:()=>",
          "indirectStarExportName:()=>",
          "[\"mappedExportName\",,\"otherMappedExportName\",\"with,comma\"]"
        ],
        "notContains": [
          "privateExportName",
          "asyncExportName",
          "starExportName:()=>",
          "collidingStarExportName:()=>",
          "barrelExportName:()=>"
        ]
      }
    ]
  },
  {
    "description": "private exports: development keeps export names",
    "input": "index.js",
    "output": [
      "value",
      "default",
      "value",
      "default",
      "method",
      "star",
      "collision",
      "barrel",
      "escapedExportName",
      "value-async",
      "mappedExportName,mapped,otherMappedExportName,other,ownExport,own,with,comma,comma",
      "mapped",
      "indirect"
    ]
  }
]
