{
  "extends": "@parcel/config-default",
  "transformers": {
    "*.css": [
      {
        "plugin": "@parcel/transformer-css",
        "config": {
          "cssModules": true,
          "pseudoClasses": {
            "hover": "is-hovered",
            "active": "is-active",
            "focus": "is-focused",
            "focusVisible": "is-focus-visible",
            "focusWithin": "has-focus-within"
          }
        }
      }
    ]
  }
}
