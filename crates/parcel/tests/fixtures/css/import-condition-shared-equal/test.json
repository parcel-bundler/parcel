{
  "description": "stylesheets imported under identical conditions share one bundle wrapped in that condition",
  "input": "index.js",
  "options": {
    "mode": "production"
  },
  "skipNodeModules": true,
  "bundles": [
    {
      "assets": ["index.js"],
      "references": []
    },
    {
      "assets": ["pageA.js"],
      "references": [["a.css"], ["shared.css"]]
    },
    {
      "assets": ["pageB.js"],
      "references": [["b.css"], ["shared.css"]]
    },
    {
      "assets": ["a.css"],
      "references": []
    },
    {
      "assets": ["b.css"],
      "references": []
    },
    {
      "assets": ["shared.css"],
      "references": []
    }
  ]
}
