{
  "description": "stylesheets imported in conflicting orders are fully duplicated per context so each activation asserts its own cascade",
  "input": "index.js",
  "options": {
    "mode": "production"
  },
  "skipNodeModules": true,
  "bundles": [
    {
      "assets": ["index.js"],
      "references": []
    },
    {
      "assets": ["pageA.js"],
      "references": [["x.css", "y.css"]]
    },
    {
      "assets": ["pageB.js"],
      "references": [["x.css", "y.css"]]
    },
    {
      "assets": ["x.css", "y.css"],
      "references": []
    },
    {
      "assets": ["x.css", "y.css"],
      "references": []
    }
  ]
}
