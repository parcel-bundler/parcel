{
  "description": "stylesheets imported in conflicting orders are duplicated per context to preserve each cascade",
  "input": "index.js",
  "options": {
    "mode": "production"
  },
  "skipNodeModules": true,
  "bundles": [
    {
      "assets": ["index.js"],
      "references": []
    },
    {
      "assets": ["pageA.js"],
      "references": [["x.css"], ["y.css"]]
    },
    {
      "assets": ["pageB.js"],
      "references": [["y.css"], ["x.css"]]
    },
    {
      "assets": ["y.css"],
      "references": []
    },
    {
      "assets": ["x.css"],
      "references": []
    },
    {
      "assets": ["x.css"],
      "references": []
    }
  ]
}
