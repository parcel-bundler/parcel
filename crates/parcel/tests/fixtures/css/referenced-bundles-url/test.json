{
  "description": "a stylesheet loaded by URL keeps its reference @imports, since nothing else loads them",
  "input": ["index.js", "other.css"],
  "options": {"mode": "production", "contentHash": false},
  "skipNodeModules": true,
  "bundles": [
    {"assets": ["index.js"]},
    {
      "assets": ["other.css"],
      "references": [["shared.css"]],
      "contains": ["@import"]
    },
    {
      "assets": ["sheet.css"],
      "references": [["shared.css"]],
      "contains": ["@import"]
    },
    {"assets": ["shared.css"], "references": []}
  ]
}
