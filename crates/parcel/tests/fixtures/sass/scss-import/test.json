{
  "description": "should support scss imports",
  "options": {"config": "../.parcelrc"},
  "input": "index.js",
  "bundles": [
    {"name": "index.js", "assets": ["index.js"]},
    {
      "type": "css",
      "assets": ["index.scss"],
      "contains": [".index", ".foo", ".bar"]
    }
  ],
  "output": 2
}
