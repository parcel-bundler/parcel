{
  "description": "bundles number the modules nothing outside them refers to, and keep the ids of those other bundles require",
  "input": "index.html",
  "options": {
    "mode": "production",
    "config": ".parcelrc"
  },
  "skipNodeModules": true,
  "bundles": [
    {
      "assets": ["index.html"]
    },
    {
      "assets": ["a.js", "helper.js"],
      "contains": ["var h=[(a,b", "r(0)"]
    },
    {
      "assets": ["b.js"],
      "contains": ["var h=[];"]
    },
    {
      "assets": ["shared.js"],
      "contains": ["var h=[];"]
    },
    {
      "assets": ["lazy.js", "util.js"],
      "contains": ["var h=[(a,b", "r(0)"]
    }
  ],
  "sideEffects": ["a:shared:helper", "b:shared", "a:lazy:shared:util", "b:lazy:shared:util"]
}
