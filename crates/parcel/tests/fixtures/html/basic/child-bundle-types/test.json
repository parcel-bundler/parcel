{
  "description": "should support child bundles of different types",
  "input": "index.html",
  "bundles": [
    {
      "type": "html",
      "assets": ["index.html"]
    },
    {
      "type": "js",
      "assets": ["main.js"]
    },
    {
      "type": "html",
      "assets": ["other.html"]
    },
    {
      "type": "js",
      "assets": ["index.js"]
    },
    {
      "type": "js",
      "assets": ["other.js", "util.js"]
    }
  ]
}
