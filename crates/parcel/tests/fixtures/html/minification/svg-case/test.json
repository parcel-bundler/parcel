{
  "description": "should normalize case of SVG elements and attributes when minified",
  "input": "index.html",
  "options": {"mode": "production"},
  "bundles": [
    {"type": "html", "assets": ["index.html"], "contains": [
      "<x-custom stddeviation=0.5",
      "<svg preserveAspectRatio=\"xMinYMin meet\" role=img viewBox=\"1.8 2.4 2 2\"",
      "<filter",
      "<feGaussianBlur in=SourceGraphic stdDeviation"
    ]},
    {"type": "html", "assets": ["other.html"]}
  ]
}
