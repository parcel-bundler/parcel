{
  "description": "should hoist synchronous JSON bundles as ESM imports",
  "input": "index.js",
  "options": {
    "config": ".parcelrc"
  },
  "bundles": [
    {
      "type": "js",
      "assets": ["esmodule-helpers.js", "index.js"],
      "contains": [
        "import __parcelSyncBundle",
        "with {type:\"json\"};",
        "\":__parcelSyncBundle"
      ],
      "notContains": ["module.exports=module.bundle.nodeRequire("]
    },
    {
      "type": "json",
      "assets": ["data.json"]
    }
  ]
}
