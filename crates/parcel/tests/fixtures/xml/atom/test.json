        "assets": ["atom.xml"],
        "contains": [
          "<link href=\"http://example.org/post.html\"/>",
          "<img src=\"{{bundle:100x100.png}}\"/>",
          "<?xml-stylesheet type=\"text/xsl\" href=\"{{bundle:atom.xsl}}\"?>",
          "<div xmlns=\"http://www.w3.org/1999/xhtml\">"
        ],
        "notContains": ["data-parcel-key", "https://parceljs.org"]
      },
      {
        "type": "png",
        "assets": ["100x100.png"]
      },
      {
        "name": "post.html",
        "type": "html",
        "assets": ["post.html"]
      },
      {
        "type": "xsl",
        "assets": ["atom.xsl"]
      }
    ]
  }
]
