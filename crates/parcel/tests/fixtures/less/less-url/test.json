{
  "description": "should support linking to assets with url() from less",
  "input": "index.js",
  "bundles": [
    {"name": "index.js", "assets": ["index.js"]},
    {
      "type": "css",
      "assets": ["index.less"],
      "contains": ["test-", ".woff2", "http://google.com", ".index"]
    },
    {"type": "woff2", "assets": ["test.woff2"]}
  ],
  "output": 2
}
