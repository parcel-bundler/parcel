[
  {
    "description": "lazy bundles load everything they reference",
    "input": "index.js",
    "output": "abc"
  },
  {
    "description": "lazy stylesheets are loaded by their dist-root-relative name",
    "input": "css.js",
    "bundles": [
      {
        "name": "css.js",
        "assets": [
          "css.js"
        ],
        "contains": [
          "module.bundle.loadCSS(\""
        ],
        "notContains": [
          "loadCSS('./"
        ]
      },
      {
        "assets": [
          "styled.js"
        ]
      },
      {
        "type": "css",
        "assets": [
          "styled.css"
        ]
      }
    ],
    "skipNodeModules": true
  },
  {
    "description": "lazy bundles don't run their main entry on load, before the bundles they depend on have loaded",
    "input": "index.js",
    "skipNodeModules": true,
    "bundles": [
      {
        "name": "index.js",
        "assets": [
          "index.js"
        ],
        "notContains": [
          "var mainEntry = null;"
        ]
      },
      {
        "assets": [
          "a.js"
        ],
        "contains": [
          "var mainEntry = null;"
        ]
      },
      {
        "assets": [
          "b.js"
        ],
        "contains": [
          "var mainEntry = null;"
        ]
      },
      {
        "assets": [
          "c.js"
        ],
        "contains": [
          "var mainEntry = null;"
        ]
      }
    ],
    "output": "abc"
  }
]
