{
  "description": "duplicates modules between worker and browser contexts",
  "input": "index.html",
  "options": {"mode": "production"},
  "bundles": [
    {
      "type": "html",
      "assets": ["index.html"]
    },
    {
      "type": "js",
      "assets": ["esmodule-helpers.js", "index.js", "index.js"]
    },
    {
      "type": "js",
      "assets": ["esmodule-helpers.js", "index.js", "worker.js"]
    }
  ]
}
