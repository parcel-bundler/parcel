[
  {
    "description": "bundles service workers with stable names",
    "input": "a/index.js",
    "bundles": [
      {
        "name": "a/index.js",
        "assets": [
          "index.js",
          "index.js"
        ]
      },
      {
        "name": "b/nested/worker-nested.js",
        "environment": "service-worker",
        "assets": [
          "worker-nested.js"
        ]
      },
      {
        "name": "b/worker-outside.js",
        "environment": "service-worker",
        "assets": [
          "worker-outside.js"
        ]
      }
    ]
  },
  {
    "description": "bundles service workers with type: module",
    "input": "module.js",
    "bundles": [
      {
        "name": "module.js",
        "assets": [
          "module.js"
        ]
      },
      {
        "name": "module-worker.js",
        "environment": "service-worker",
        "assets": [
          "esmodule-helpers.js",
          "module-worker.js"
        ]
      }
    ]
  },
  {
    "description": "preserves the scope option for service workers",
    "input": "scope.js",
    "bundles": [
      {
        "assets": [
          "scope.js"
        ],
        "contains": [
          "scope: 'foo'"
        ]
      },
      {
        "name": "module-worker.js",
        "assets": [
          "esmodule-helpers.js",
          "module-worker.js"
        ]
      }
    ]
  },
  {
    "description": "errors when a classic service worker has exports",
    "input": "error.js",
    "diagnostics": [
      {
        "message": "SCRIPT_ERROR",
        "origin": "@parcel/transformer-js"
      }
    ]
  }
]
