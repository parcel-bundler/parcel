{
  "description": "creates a shared bundle to deduplicate assets in workers",
  "input": "index.js",
  "options": {
    "mode": "production"
  },
  "bundles": [
    {
      "assets": ["esmodule-helpers.js", "index.js", "index.js"],
      "references": []
    },
    {
      "assets": ["worker-a.js"],
      "references": [["esmodule-helpers.js", "index.js"]]
    },
    {
      "assets": ["worker-b.js"],
      "references": [["esmodule-helpers.js", "index.js"]]
    },
    {
      "assets": ["esmodule-helpers.js", "index.js"],
      "references": []
    }
  ]
}
