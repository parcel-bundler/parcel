          "\"other\":{\"image\":\"missing.png\"}",
          "\"caption\":\"icon.png\"",
          "\"url\":\"https://cdn.example.com/assets/icon-",
          "#logo\"",
          "\"photo\":\"https://cdn.example.com/assets/icon-",
          "\"image\":[\"https://cdn.example.com/assets/icon-",
          "\"contentUrl\":\"https://cdn.example.com/assets/icon-",
          "\"thumbnailUrl\":\"https://cdn.example.com/assets/icon-",
          "\"embedUrl\":\"https://cdn.example.com/assets/icon-",
          "\"thumbnail\":\"https://example.com/remote.png\"",
          "\"screenshot\":\"data:image/png;base64,AAAA\"",
          "null,42,true"
        ],
        "notContains": [
          "\"url\":\"icon.png\"",
          "\"photo\":\"icon.png\"",
          "\"contentUrl\":\"icon.png\"",
          "\"thumbnailUrl\":\"icon.png\"",
          "\"embedUrl\":\"icon.png\""
        ]
      },
      {
        "type": "png",
        "assets": [
          "icon.png"
        ]
      }
    ]
  },
